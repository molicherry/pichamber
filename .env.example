# pichamber 环境变量示例 — 复制为 .env 后填写。
# .env 本身不提交(见 .gitignore),本文件是唯一提交的模板。

# HTTP 服务端口(默认 8787;本机部署用 30142)
PORT=8787

# 可选:额外允许的跨域 origin(逗号分隔)。部署时填你的域名,如:
# PICAMBER_ALLOWED_ORIGIN=https://your-app.example.com
# 不设置则只允许 localhost/127.0.0.1。
# PICAMBER_ALLOWED_ORIGIN=

# 可选:UI 密码认证(PICAMBER_PASSWORD)。设置后浏览器打开会弹密码门
# (openchamber 的 desktop-ui-password 等价物),登录成功后种 session cookie。
# 不设置则密码门关闭(但如果同时不设 PICAMBER_TOKEN,服务保持开放)。
# PICAMBER_PASSWORD=

# 可选:静态 bearer token 认证(PICAMBER_TOKEN)。用于 API/自动化客户端
# (curl 等),不影响 UI 密码门。设置后 /api 请求必须携带此 token
# (Authorization: Bearer <token> 或 ?token=<token>)。
# PICAMBER_TOKEN=

# 可选:前端构建产物目录(默认 packages/ui/dist)
# UI_DIST=
