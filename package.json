{
  "name": "pichamber",
  "version": "0.1.2",
  "description": "pi-agent workspace with an openchamber-style upper layer and a pi-agent abstraction bottom layer",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "type-check": "bun run --filter '*' type-check",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "build:publish": "node scripts/build-publish.cjs",
    "release:scenarios": "node scripts/release/scenarios.cjs",
    "release:gate-self-test": "node scripts/release/self-test.cjs",
    "release:qualify": "node scripts/release/qualify.cjs",
    "release:publish": "node scripts/release/publish.cjs"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
